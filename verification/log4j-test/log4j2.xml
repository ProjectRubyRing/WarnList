<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="APP" target="SYSTEM_OUT">
      <PatternLayout pattern="APPLOG4J|%level|%logger|%msg%n"/>
    </Console>
  </Appenders>
  <Loggers>
    <Root level="info"><AppenderRef ref="APP"/></Root>
  </Loggers>
</Configuration>
